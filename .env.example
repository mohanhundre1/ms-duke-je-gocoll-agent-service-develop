# ms-duke-je-gocoll-agent-service - Environment Variables
# Copy to .env and fill in values before running `docker compose up`.
#
# Every variable below is read by this service's code or by the
# ms-duke-je-common modules it imports. Commented-out lines show the
# in-code default; uncomment only to override.

# == Runtime mode ==================================================
# all (default) -> start both agents in one container (docker-compose)
# executor     -> start ONLY the GOCOLL Weekly JE agent   (GOCOLL_AGENT_PORT)
# orchestrator -> start ONLY the GOCOLL Orchestrator agent (ORCHESTRATOR_PORT)
# In Kubernetes, ROLE must be a single role (serve.py refuses "all" when
# KUBERNETES_SERVICE_HOST is set).
# ROLE=all

# local | dev | staging | production
# Anything outside local/dev/development/test enforces the production-required
# set (INTERNAL_SERVICE_KEY, AZURE_OPENAI_ENDPOINT) and exits 1 if missing.
ENVIRONMENT=local

# == Agent ports / A2A addressing ==================================
# serve.py passes these through as uvicorn --port, so they are both the
# container-internal and the published port.
GOCOLL_AGENT_PORT=8018
ORCHESTRATOR_PORT=8019
# Host advertised in the agent cards (NOT the bind address).
A2A_HOST=duke-gocoll
# Bind address for uvicorn.
# A2A_BIND_HOST=0.0.0.0
# Overrides A2A_HOST in the orchestrator card only.
# A2A_ADVERTISE_HOST=
# Public base URL used for the card's ingress-prefixed URLs and by the URI guard.
# SERVICE_BASE_URL=https://fms-duke.fol-dev.ey.com

# == Governed memory (conversation history recovery) ===============
# The no-inline-input recovery path reads prior-turn file uploads through the
# governed memory service (ctx.services.memory), not a raw HTTP call. By default
# it uses the conversation_manager backend at {SERVICE_BASE_URL}/conversation-manager
# - so setting SERVICE_BASE_URL above is all that's normally required.
#
# Optional overrides (only when CM isn't behind the shared ingress prefix, e.g.
# a different host/port in local dev):
#   MEMORY_PROVIDER - conversation_manager (default) | in_memory | postgres
#   CONVERSATION_MANAGER_URL - CM service root; overrides the SERVICE_BASE_URL path
# CONVERSATION_MANAGER_URL=http://localhost:8085

# == Downstream agents / callbacks =================================
GOCOLL_AGENT_URL=http://duke-gocoll:8018
ERP_TEMPLATE_AGENT_URL=http://duke-shared-agents:8002
CALLBACK_BASE_URL=http://duke-api:8090
DEFAULT_ERP_TYPE=gocoll
# Seconds to wait for a downstream A2A call (code default 1800).
A2A_CALL_TIMEOUT=900
# CALLBACK_TIMEOUT=30
# CALLBACK_MAX_RETRIES=3
# CALLBACK_CIRCUIT_THRESHOLD=5
# CALLBACK_CIRCUIT_RECOVERY_S=30
# Comma-separated allow-list enforced on inbound callback URLs. Empty = allow all.
CALLBACK_URL_ALLOWED_HOSTS=duke-api,duke-delegation,localhost,127.0.0.1,host.docker.internal
# A2A client retry / circuit-breaker tuning (ms-duke-je-common transport).
# A2A_CLIENT_MAX_RETRIES=2
# A2A_CLIENT_RETRY_BASE_DELAY_S=0.5
# A2A_CLIENT_RETRY_MAX_DELAY_S=5.0
# A2A_CLIENT_CB_FAILURE_THRESHOLD=3
# A2A_CLIENT_CB_RECOVERY_TIMEOUT_S=30.0

# == LLM provider ==================================================
# azure openai (default) | openai
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Required only when LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Vision deployment names passed as `model=` on every chat call. These MUST
# match real Azure OpenAI deployment names in AZURE_OPENAI_ENDPOINT, otherwise
# the vision tier degrades to the text tier.
GOCOLL_VISION_MODEL=gpt-4.1
GOCOLL_VISION_FALLBACK_MODEL=gpt-4.1

# == GOCOLL vision / pipeline tuning ===============================
# GOCOLL_VISION_DPI=400
# GOCOLL_VISION_MAX_TOKENS=16384
# GOCOLL_VISION_CONCURRENCY=6
# GOCOLL_BATCH_CONCURRENCY=4
# GOCOLL_VISION_MAX_RETRIES=3
# GOCOLL_VISION_RETRY_BASE_S=1.5
# Page tiling: cols x rows + 1 full page = images per vision call.
# 3x3 (default) = 10 images/call; 2x2 = 5; set both to 1 (or TILING=off) = 1.
# Reduce if runs hit API rate limits or take too long.
GOCOLL_VISION_TILE_COLS=2
GOCOLL_VISION_TILE_ROWS=2
GOCOLL_VISION_TILING=on
GOCOLL_VISION_TILE_OVERLAP=0.10
GOCOLL_VISION_INCLUDE_FULL_PAGE=1
# Debug only: write every rendered page/tile to this dir instead of a temp dir.
GOCOLL_VISION_DUMP_DIR=
GOCOLL_LOG_VISION_RESULTS=1
GOCOLL_VISION_LOG_MAX_CHARS=8000
# Validation rule pack resolved from ms_duke_je_common.assembly_gate.
GOCOLL_RULE_PACK=gocoll_v1
# Per-run LLM budget overrides (RateLimiter, agent key "GOCOLL").
GOCOLL_MAX_LLM_CALLS=
GOCOLL_MAX_PROMPT_TOKENS=
GOCOLL_MAX_COMPLETION_TOKENS=

# == Internal service auth =========================================
# Shared key for x-internal-auth on inbound A2A calls, config-registry writes,
# FileManager downloads and progress callbacks.
INTERNAL_SERVICE_KEY=<shared-internal-service-key>
# Falls back to INTERNAL_SERVICE_KEY when unset.
CALLBACK_SECRET=<callback-secret-or-same-as-internal-service-key>

# == Inbound caller auth (orchestrator authenticate_inbound) =======
# local (HS256 JWT) | azure (Entra ID)
AUTH_PROVIDER=local
JWT_SECRET=<local-dev-jwt-secret>
JWT_ALGORITHM=HS256
# Required when AUTH_PROVIDER=azure
# AUTH_TENANT_ID=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_ID_SECONDARY=
# AUTH_CLIENT_SECRET=
# AZURE_VALID_AUDIENCE=
# AZURE_TENANT_ID=

# == Secret provider ===============================================
# env      = read from this .env (default for local dev)
# keyvault = fetch via DefaultAzureCredential at startup
SECRET_PROVIDER=env
# AZURE_KEYVAULT_URL=https://<your-vault>.vault.azure.net/
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# SECRET_CACHE_TTL_SECONDS=
# 0/unset disables the background refresh loop.
# SECRET_REFRESH_INTERVAL_SECONDS=

# == Storage backend ===============================================
# local = filesystem | azure_blob = Azure Blob Storage / Azurite
STORAGE_BACKEND=local
# Filesystem roots for STORAGE_BACKEND=local (set as absolute paths in the image).
# UPLOAD_DIR=/app/uploads
# APP_OUTPUT_DIR=/app/app_output
# Either a full connection string, or an account name + managed identity.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;...
# AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
# AZURE_STORAGE_INPUT_CONTAINER=duke-inputs
# AZURE_STORAGE_OUTPUT_CONTAINER=duke-outputs
# AZURE_BLOB_CACHE_DIR=
# STORAGE_DOWNLOAD_CONCURRENCY=8

# == Config registry ===============================================
CONFIG_REGISTRY_URL=http://duke-api:8090
CONFIG_REGISTRY_ENABLED=true
# CONFIG_REGISTRY_TIMEOUT=30
# CONFIG_CACHE_TTL=18000

# == SSRF guard for inbound file URIs ==============================
# URI_GUARD_ALLOWED_SCHEMES=https,http,azure,blob
# URI_GUARD_ALLOWED_HOSTS=*.blob.core.windows.net
# Set false for local docker/host URLs (duke-api, host.docker.internal).
# URI_GUARD_DENY_PRIVATE_IPS=true

# == Observability =================================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# OTEL_SERVICE_NAME=duke-gocoll
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_CONSOLE_SPANS=0
# Standard Otel SDK kill-switches for local runs without a collector.
# OTEL_SDK_DISABLED=true
# Optional USD rates used to derive the LLM cost metric.
# LLM_COST_PROMPT_USD_PER_1K=
# LLM_COST_COMPLETION_USD_PER_1K=

# == GenAI telemetry (opt-in; off by default) ======================
# Enables the openai-v2 auto-instrumentor in common (gen_ai spans stamped with
# duke.* identity + tenant-dimensioned llm.tokens/llm.cost.usd). Read once at
# process start - restart to toggle. Message-content capture stays OFF
# (financial/PII): common forces NO_CONTENT, do not override it.
# DUKE_GENAI_TELEMETRY=on
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental