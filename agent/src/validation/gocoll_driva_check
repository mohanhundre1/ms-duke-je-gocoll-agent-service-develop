"""GOCOLL Derivation follow-up for Validation Tab failures.

The SOP does not define a special rule for Deriva Energy Business Units.
Instead, whenever any value fails an Excel Validation Tab restriction, an
analyst must confirm the accounting codeblock in the PeopleSoft Derivation
validation setup. If valid, only the rejected value is added to its matching
Validation Tab column/dropdown. If invalid, the analyst contacts the user and
uses Suspense or Miscellaneous.

This advisory check turns actual Validation Tab failures into those SOP
instructions. It never changes the uploaded Validation Tab or invents a code
block because the required PeopleSoft confirmation is a human step.
"""

from __future__ import annotations

import logging

from src.models.domain import CheckResult
from src.models.enums import ValidationStatus
from src.models.gocoll_assembly_models import GoCollAssemblyResult

logger = logging.getLogger(__name__)


def check_deriva_guard(
    assembly: GoCollAssemblyResult,
    validation_tab_failures: list[str] | None = None,
) -> CheckResult:
    """Route actual Validation Tab failures to SOP Derivation confirmation.

    Args:
        assembly: Engine 3 output. Retained in the signature for the validation
            check contract; no lines are independently classified here.
        validation_tab_failures: The failure list from ``check_validation_tab``
            (empty or ``None`` when that check passed or was skipped).

    Returns:
        ``PASS`` when the Validation Tab had no failures; otherwise ``REVIEW``
        with one Derivation follow-up instruction per rejected value.
    """
    del assembly
    failures = list(validation_tab_failures or [])
    flags = [
        f"{failure} - confirm the accounting codeblock via the Derivation "
        "validation setup; if valid, add only the rejected value to its "
        "corresponding Validation Tab column/dropdown; if invalid, contact "
        "the user and use Suspense or Miscellaneous"
        for failure in failures
    ]

    if flags:
        logger.info(
            "GOCOLL deriva_guard REVIEW: %d Validation Tab failure(s) need "
            "Derivation confirmation",
            len(flags),
        )
    else:
        logger.info(
            "GOCOLL deriva_guard PASS: no Validation Tab failures need "
            "Derivation confirmation"
        )

    return CheckResult(
        check_name="deriva_guard",
        status=ValidationStatus.REVIEW if flags else ValidationStatus.PASS,
        details=(
            f"{len(flags)} rejected Validation Tab value(s) require Derivation confirmation"
            if flags
            else "No Validation Tab failures require Derivation confirmation"
        ),
        failures=flags,
    )